  {
   "t": "Rohstoffe",
   "d": "Erze für Kupfer, Gold, Zinn und Seltene Erden aus vielen Ländern"
  },
  {
   "t": "Herstellung",
   "d": "Platinen und Akkus in Asien, sehr energieintensiv"
  },
  {
   "t": "Nutzung",
   "d": "Oft nur wenige Jahre"
  },
  {
   "t": "Heute oft",
   "d": "Liegt in der Schublade oder landet im Restmüll",
   "tone": "bad"
  },
  {
   "t": "Besser",
   "d": "Reparieren, weitergeben, dann Elektro-Sammlung",
   "tone": "good"
  }
 ],
 "entsorgung": {
  "wo": "Recyclinghof oder Rücknahme im Handel. Kleine Elektrogeräte bis 25 cm nehmen auch große Supermärkte kostenlos zurück.",
