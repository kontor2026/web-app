  {
   "t": "Herstellung",
   "d": "Platinen und Akkus in Asien, sehr energieintensiv"
  },
  {
   "t": "Nutzung",
   "d": "Oft nur wenige Jahre"
  },
  {
   "t": "Heute oft",
   "d": "Liegt in der Schublade oder landet im Restmüll",
   "tone": "bad"
  },
  {
   "t": "Besser",
   "d": "Reparieren, weitergeben, dann Elektro-Sammlung",
   "tone": "good"
  }
 ],
