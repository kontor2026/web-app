# Kopieren nach .env und anpassen. .env wird nicht committet.

# KI-Anbieter:
#   lokal       Inferenz-Container (Ollama), offline, langsam auf CPU
#   claude      Anthropic-API mit API-Schlüssel aus https://platform.claude.com
#   claude-abo  Claude Agent SDK mit Abo-Zugang (nur mit Freigabe von Anthropic, z. B. privater Test)
LLM_PROVIDER=lokal

# Zugangsdaten gehören NICHT in diese Datei, sondern als Secrets nach secrets/ (siehe docs/claude-sdk.md):
#   secrets/claude_oauth_token.txt   für LLM_PROVIDER=claude-abo
#   secrets/anthropic_api_key.txt    für LLM_PROVIDER=claude
CLAUDE_MODEL=claude-opus-5-5

# Lokales Modell im Inferenz-Container
BASE_MODEL=qwen3-vl:4b
STATION_MODEL=station-vl
