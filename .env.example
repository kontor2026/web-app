# Kopieren nach .env und anpassen. .env wird nicht committet.

# KI-Anbieter: lokal (Inferenz-Container) oder claude (Anthropic-API, schneller und genauer)
LLM_PROVIDER=lokal

# Nur für LLM_PROVIDER=claude: API-Schlüssel aus https://platform.claude.com (Console).
# Ein claude.ai-Abo (Pro/Max) ist kein API-Zugang und darf dafür nicht verwendet werden.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Lokales Modell im Inferenz-Container
BASE_MODEL=qwen3-vl:4b
STATION_MODEL=station-vl
